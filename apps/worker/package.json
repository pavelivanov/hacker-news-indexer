{
  "name": "@hn-knowledge/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b --pretty false",
    "dev": "tsx watch src/index.ts",
    "schedule:once": "node --enable-source-maps dist/schedule-once.js",
    "start": "node --enable-source-maps dist/index.js",
    "telegram:session:check": "node --env-file-if-exists=../../.env --enable-source-maps dist/telegram-session.js"
  },
  "dependencies": {
    "@hn-knowledge/adapters": "0.1.0",
    "@hn-knowledge/application": "0.1.0",
    "@hn-knowledge/config": "0.1.0",
    "@hn-knowledge/db": "0.1.0",
    "@hn-knowledge/domain": "0.1.0",
    "@hn-knowledge/ports": "0.1.0"
  }
}
