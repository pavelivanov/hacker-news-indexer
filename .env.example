NODE_ENV=development
LOG_LEVEL=info
PORT=3000
DATABASE_URL=postgresql://hn_knowledge:hn_knowledge@127.0.0.1:5432/hn_knowledge
APP_API_TOKEN=
INGESTION_MAX_RANGE=1000
DATABASE_READY_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# Telegram is read-only and worker-only. Keep the session path outside source control.
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=.sessions/telegram.session
TELEGRAM_SOURCE_KEY=hn_best_comments
TELEGRAM_REQUEST_TIMEOUT_MS=15000
TELEGRAM_MAX_FLOOD_WAIT_MS=30000
HN_REQUEST_TIMEOUT_MS=10000
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_DURATION_MS=60000
WORKER_MAX_ATTEMPTS=4
WORKER_RETRY_BASE_MS=1000

# Classification remains disabled until Plan 003.
CLASSIFIER_ENABLED=false
CLASSIFIER_PROVIDER=
CLASSIFIER_API_TOKEN=
CLASSIFIER_MODEL=
CLASSIFIER_REQUEST_TIMEOUT_MS=45000
