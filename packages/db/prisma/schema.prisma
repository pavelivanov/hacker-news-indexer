  canonicalText     String?             @map("canonical_text")
  contentHash       String              @map("content_hash")
  availability      HnAvailabilityState
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  supersededAt      DateTime?           @map("superseded_at") @db.Timestamptz(3)
  selectedComment   SelectedComment     @relation(fields: [selectedCommentId], references: [id], onDelete: Restrict)

  @@unique([selectedCommentId, revision])
  @@unique([selectedCommentId, contentHash])
  @@index([selectedCommentId, createdAt])
  @@map("selected_comment_revisions")
}

model ResolutionPathRevision {
