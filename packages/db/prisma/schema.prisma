  resolvedRootId    BigInt          @map("resolved_root_id")
  resolverVersion   String          @map("resolver_version")
  resolvedAt        DateTime        @default(now()) @map("resolved_at") @db.Timestamptz(3)
  selectedComment   SelectedComment @relation(fields: [selectedCommentId], references: [id], onDelete: Restrict)

  @@unique([selectedCommentId, revision])
  @@index([resolvedRootId, resolvedAt])
  @@map("resolution_path_revisions")
}

model HnReconciliationEvent {
  id                   String                  @id @default(uuid()) @db.Uuid
  selectedCommentId    BigInt                  @map("selected_comment_id")
  outcome              HnReconciliationOutcome
  previousResponseHash String?                 @map("previous_response_hash")
  currentResponseHash  String                  @map("current_response_hash")
  previousContentHash  String                  @map("previous_content_hash")
  currentContentHash   String                  @map("current_content_hash")
  previousRootId       BigInt                  @map("previous_root_id")
  currentRootId        BigInt                  @map("current_root_id")
  availability         HnAvailabilityState
  idempotencyKey       String                  @unique @map("idempotency_key")
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  selectedComment      SelectedComment         @relation(fields: [selectedCommentId], references: [id], onDelete: Restrict)

  @@index([selectedCommentId, createdAt])
  @@index([outcome, createdAt])
  @@map("hn_reconciliation_events")
}

model ManualReviewDraft {
  id                   String   @id @default(uuid()) @db.Uuid
  commentId            BigInt   @unique @map("comment_id")
  payload              Json
  version              Int      @default(1)
  sourceHash           String   @map("source_hash") @db.VarChar(64)
  baseActiveDecisionId  String?  @map("base_active_decision_id") @db.Uuid
  state                String   @default("DRAFT") @db.VarChar(16)
  actorId              String   @map("actor_id") @db.VarChar(128)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  comment              SelectedComment @relation(fields: [commentId], references: [id], onDelete: Restrict)
  decision             ContentDecision?
  receipt              ManualReviewReceipt?
  @@map("manual_review_drafts")
}

model ManualReviewReceipt {
  commandKey  String @id @map("command_key") @db.VarChar(160)
  draftId     String @unique @map("draft_id") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  result      Json
  draft       ManualReviewDraft @relation(fields: [draftId], references: [id], onDelete: Restrict)
  @@map("manual_review_receipts")
}
