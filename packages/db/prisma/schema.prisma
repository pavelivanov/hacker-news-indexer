generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SelectionSource {
  TELEGRAM
  FIXTURE
}

enum IngestionRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum OccurrenceStatus {
  OBSERVED
  MISSING
  DELETED
  RESOLVED
  FAILED
}

enum HnReferenceRole {
  DISPLAYED_STORY_REFERENCE
  SELECTED_COMMENT
  INLINE_HN_REFERENCE
}

enum PipelineJobType {
  INGEST_SELECTION_RANGE
  RESOLVE_HN_COMMENT
  CLASSIFY_COMMENT
  RECONCILE_HN_ITEM
}

enum PipelineJobState {
  AVAILABLE
  LEASED
  COMPLETED
  RETRYABLE
  TERMINAL
}

enum HnItemType {
  comment
  story
  poll
  pollopt
  job
}

enum HnAvailabilityState {
  AVAILABLE
  DELETED
  DEAD
  MISSING
}

enum MultipartState {
  AWAITING_PARTS
  COMPLETE_MATCH
  COMPLETE_MISMATCH
  INCOMPLETE_SNAPSHOT
  CONFLICTING_PARTS
}

enum UrlValidationState {
  CANDIDATE
  VALID
  REJECTED
}

enum ClassificationRunStatus {
  SUCCEEDED
  REVIEW
  FAILED
}

enum ContentDecisionClass {
  DISCOVERY
  EXPERT_NOTE
  REJECTED
  REVIEW
}

enum ContentDecisionSource {
  MODEL
  MANUAL
}

enum EvidenceOrigin {
  COMMENT
  ROOT_STORY
}

enum ReviewTaskState {
  OPEN
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ReviewPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewTaskKind {
  CONTENT_DECISION
  SUBJECT_MERGE
  URL_RESOLUTION
  FINDTHATPROJECT_EXPORT
}

enum ExportDestination {
  FINDTHATPROJECT
}

enum ExportAction {
  UPSERT
  RETRACT
}

enum ExportDeliveryState {
  PENDING
  ACKNOWLEDGED
}

enum ReviewAuditAction {
  OPENED
  APPROVED
  REJECTED
  REOPENED
  SUPERSEDED
}

enum SubjectType {
  PROJECT
  TOOL
  LIBRARY
  SERVICE
  PRODUCT
  FEATURE
  PLUGIN
  AGENT_SKILL
  GUIDE
  RESOURCE
}

enum SubjectIdentityBasis {
  ECOSYSTEM_COORDINATE
  CANONICAL_URL
  OFFICIAL_DOMAIN
  NAME_CONTEXT
}

enum SubjectLifecycleState {
  ACTIVE
  MERGED
  TOMBSTONED
}

enum MaterializedEvidenceOrigin {
  COMMENT
  ROOT_STORY
  BOTH
}

enum MaterializedContentStatus {
  REVIEW_PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum SubjectMentionSource {
  DISCOVERY
  EXPERT_NOTE
}

enum ExpertNoteType {
  TECHNICAL_EXPLANATION
  CORRECTION
  PRODUCT_EXPERIENCE
  IMPLEMENTATION_CAVEAT
  SECURITY
  OPERATIONS
  COMPARISON
  GUIDE
}

enum HnReconciliationOutcome {
  UNCHANGED
  CONTENT_CHANGED
  ROOT_CHANGED
  TOMBSTONED
}

model IngestionRun {
  id             String                   @id @default(uuid()) @db.Uuid
  source         SelectionSource
  sourceKey      String                   @map("source_key")
  minId          BigInt                   @map("min_id")
  maxId          BigInt                   @map("max_id")
  cursor         BigInt?
  requestKey     String                   @unique @map("request_key")
  codeVersion    String                   @default("development") @map("code_version")
  status         IngestionRunStatus       @default(PENDING)
  observedCount  Int                      @default(0) @map("observed_count")
  resolvedCount  Int                      @default(0) @map("resolved_count")
  terminalCount  Int                      @default(0) @map("terminal_count")
  failureSummary String?                  @map("failure_summary")
  startedAt      DateTime?                @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?                @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  occurrences    IngestionRunOccurrence[]
  jobs           PipelineJob[]
  feedBatch      FeedSyncBatch?

  @@index([status, createdAt])
  @@map("ingestion_runs")
}

model SelectionOccurrence {
  id            String                   @id @default(uuid()) @db.Uuid
  source        SelectionSource
  sourceKey     String                   @map("source_key")
  externalId    BigInt                   @map("external_id")
  occurredAt    DateTime?                @map("occurred_at") @db.Timestamptz(3)
  editedAt      DateTime?                @map("edited_at") @db.Timestamptz(3)
  contentHash   String?                  @map("content_hash")
  status        OccurrenceStatus         @default(OBSERVED)
  firstSeenAt   DateTime                 @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt    DateTime                 @updatedAt @map("last_seen_at") @db.Timestamptz(3)
  runs          IngestionRunOccurrence[]
  telegram      TelegramMessage?
  references    HnReference[]
  multipartPart MultipartPart?

  @@unique([source, sourceKey, externalId])
  @@index([status, occurredAt])
  @@map("selection_occurrences")
}

model IngestionRunOccurrence {
  ingestionRunId String              @map("ingestion_run_id") @db.Uuid
  occurrenceId   String              @map("occurrence_id") @db.Uuid
  attachedAt     DateTime            @default(now()) @map("attached_at") @db.Timestamptz(3)
  ingestionRun   IngestionRun        @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)
  occurrence     SelectionOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@id([ingestionRunId, occurrenceId])
  @@map("ingestion_run_occurrences")
}

model TelegramMessage {
  occurrenceId      String              @id @map("occurrence_id") @db.Uuid
  entities          Json
  displayedTextHash String?             @map("displayed_text_hash")
  bodySnapshot      String?             @map("body_snapshot")
  multipartPart     Int?                @map("multipart_part")
  multipartTotal    Int?                @map("multipart_total")
  deleted           Boolean             @default(false)
  occurrence        SelectionOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@map("telegram_messages")
}

model HnReference {
  id              String              @id @default(uuid()) @db.Uuid
  occurrenceId    String              @map("occurrence_id") @db.Uuid
  hnItemId        BigInt              @map("hn_item_id")
  role            HnReferenceRole
  entityOffset    Int                 @map("entity_offset")
  entityLength    Int                 @map("entity_length")
  parseConfidence Float               @map("parse_confidence")
  occurrence      SelectionOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, role, entityOffset, hnItemId])
  @@index([hnItemId])
  @@map("hn_references")
}

model PipelineJob {
  id             String           @id @default(uuid()) @db.Uuid
  ingestionRunId String?          @map("ingestion_run_id") @db.Uuid
  type           PipelineJobType
  payload        Json
  idempotencyKey String           @unique @map("idempotency_key")
  lane           String           @default("legacy")
  state          PipelineJobState @default(AVAILABLE)
  attempts       Int              @default(0)
  availableAt    DateTime         @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner     String?          @map("lease_owner")
  leaseExpiresAt DateTime?        @map("lease_expires_at") @db.Timestamptz(3)
  lastErrorCode  String?          @map("last_error_code")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  ingestionRun   IngestionRun?    @relation(fields: [ingestionRunId], references: [id], onDelete: Cascade)

  @@index([state, availableAt, createdAt])
  @@index([leaseExpiresAt])
  @@index([lane, state, availableAt])
  @@map("pipeline_jobs")
}

model HnItem {
  id              BigInt              @id
  type            HnItemType
  parentId        BigInt?             @map("parent_id")
  author          String?
  time            DateTime?           @db.Timestamptz(3)
  title           String?
  textHtml        String?             @map("text_html")
  textPlain       String?             @map("text_plain")
  url             String?
  availability    HnAvailabilityState
  fetchedAt       DateTime            @map("fetched_at") @db.Timestamptz(3)
  responseHash    String              @map("response_hash")
  selectedComment SelectedComment?
  urlCandidates   UrlCandidate[]
  rootDiscoveries Discovery[]         @relation("DiscoveryResolvedRoot")
  revisions       HnItemRevision[]

  @@index([parentId])
  @@index([type, availability])
  @@map("hn_items")
}

model SelectedComment {
  id                   BigInt                    @id
  rootId               BigInt                    @map("root_id")
  canonicalHtml        String                    @map("canonical_html")
  canonicalText        String                    @map("canonical_text")
  contentHash          String                    @map("content_hash")
  availability         HnAvailabilityState
  firstSeenAt          DateTime                  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt           DateTime                  @updatedAt @map("last_seen_at") @db.Timestamptz(3)
  item                 HnItem                    @relation(fields: [id], references: [id], onDelete: Restrict)
  resolutionPath       ResolutionPath?
  multipartGroup       MultipartGroup?
  classificationRuns   ClassificationRun[]
  contentDecisions     ContentDecision[]         @relation("CommentDecisions")
  activeDecisionId     String?                   @unique @map("active_decision_id") @db.Uuid
  activeDecision       ContentDecision?          @relation("ActiveContentDecision", fields: [activeDecisionId], references: [id], onDelete: SetNull)
  reviewTasks          ReviewTask[]
  manualOverrideEvents ManualOverrideEvent[]
  subjectMentions      SubjectMention[]
  discoverySources     DiscoverySource[]
  expertNotes          ExpertNote[]
  revisions            SelectedCommentRevision[]
  resolutionRevisions  ResolutionPathRevision[]
  reconciliationEvents HnReconciliationEvent[]
  manualReviewDraft    ManualReviewDraft?

  @@index([rootId])
  @@map("selected_comments")
}

model ClassificationRun {
  id                    String                  @id @default(uuid()) @db.Uuid
  commentId             BigInt                  @map("comment_id")
  inputHash             String                  @map("input_hash")
  promptVersion         String                  @map("prompt_version")
  promptHash            String                  @map("prompt_hash")
  schemaVersion         String                  @map("schema_version")
  modelConfigId         String                  @map("model_config_id")
  attempt               Int                     @default(1)
  provider              String
  modelId               String                  @map("model_id")
  outputHash            String?                 @map("output_hash")
  providerOutput        Json?                   @map("provider_output")
  latencyMs             Int?                    @map("latency_ms")
  inputTokens           Int?                    @map("input_tokens")
  cachedInputTokens     Int?                    @map("cached_input_tokens")
  cacheWriteInputTokens Int?                    @map("cache_write_input_tokens")
  outputTokens          Int?                    @map("output_tokens")
  status                ClassificationRunStatus
  errorCode             String?                 @map("error_code")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  comment               SelectedComment         @relation(fields: [commentId], references: [id], onDelete: Restrict)
  contentDecision       ContentDecision?
  resultSnapshot        ClassifierResultSnapshot?

  @@unique([commentId, inputHash, promptVersion, schemaVersion, modelConfigId, attempt], name: "runIdentity", map: "classification_runs_identity_attempt_key")
  @@index([commentId, createdAt])
  @@index([status, createdAt])
  @@map("classification_runs")
}

model FeedProcessingState {
  id                String @id @default("local")
  sourceKey         String @map("source_key")
  enabled           Boolean @default(true)
  cursor            BigInt?
  syncRequested     Boolean @default(true) @map("sync_requested")
  nextSyncAt        DateTime @default(now()) @map("next_sync_at") @db.Timestamptz(3)
  lastCheckedAt     DateTime? @map("last_checked_at") @db.Timestamptz(3)
  heartbeatAt       DateTime? @map("heartbeat_at") @db.Timestamptz(3)
  errorCode         String? @map("error_code")
  intervalSeconds   Int @default(1800) @map("interval_seconds")
  batchSize         Int @default(20) @map("batch_size")
  dailyRequestLimit Int @default(100) @map("daily_request_limit")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feed_processing_state")
}

model FeedSyncBatch {
  runId     String @id @map("run_id") @db.Uuid
  run       IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("feed_sync_batches")
}

model FeedRequestUsage {
  day      DateTime @id @db.Date
  requests Int @default(0)
  @@map("feed_request_usage")
}

model FeedCommandReceipt {
  commandKey String @id @map("command_key")
  requestHash String @map("request_hash")
  result Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("feed_command_receipts")
}

model ClassifierResultSnapshot {
  runId           String @id @map("run_id") @db.Uuid
  sourceInput     Json @map("source_input")
  originalOutput  Json? @map("original_output")
  errorCode       String? @map("error_code")
  category        String
  title           String
  summary         String
  feedbackVersion Int @default(0) @map("feedback_version")
  bookmarked      Boolean @default(false)
  bookmarkVersion Int @default(0) @map("bookmark_version")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  run             ClassificationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  feedback        ClassifierFeedback[]
  bookmarkReceipts ResultBookmarkReceipt[]

  @@index([category, createdAt, runId])
  @@index([bookmarked, createdAt, runId])
  @@map("classifier_result_snapshots")
}

model ResultBookmarkReceipt {
  commandKey String @id @map("command_key") @db.VarChar(160)
  resultId String @map("result_id") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  bookmarked Boolean
  version Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  result ClassifierResultSnapshot @relation(fields: [resultId], references: [runId], onDelete: Restrict)

  @@map("result_bookmark_receipts")
}

model ClassifierFeedback {
  id          String @id @default(uuid()) @db.Uuid
  resultId    String @map("result_id") @db.Uuid
  version     Int
  commandKey  String @unique @map("command_key")
  requestHash String @map("request_hash")
  values      Json
  actorId     String @map("actor_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  result      ClassifierResultSnapshot @relation(fields: [resultId], references: [runId], onDelete: Restrict)

  @@unique([resultId, version])
  @@map("classifier_feedback")
}

model ContentDecision {
  id                   String                @id @default(uuid()) @db.Uuid
  commentId            BigInt                @map("comment_id")
  classificationRunId  String?               @unique @map("classification_run_id") @db.Uuid
  source               ContentDecisionSource
  primaryDecision      ContentDecisionClass  @map("primary_decision")
  decisionConfidence   Float                 @map("decision_confidence")
  materiallyTechnical  Boolean               @map("materially_technical")
  reviewRequired       Boolean               @map("review_required")
  validatedOutput      Json                  @map("validated_output")
  manualDraftId        String?               @unique @map("manual_draft_id") @db.Uuid
  manualDraft          ManualReviewDraft?    @relation(fields: [manualDraftId], references: [id], onDelete: Restrict)
  manualOverrideOfId   String?               @map("manual_override_of_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  comment              SelectedComment       @relation("CommentDecisions", fields: [commentId], references: [id], onDelete: Restrict)
  classificationRun    ClassificationRun?    @relation(fields: [classificationRunId], references: [id], onDelete: Restrict)
  manualOverrideOf     ContentDecision?      @relation("ManualDecisionOverrides", fields: [manualOverrideOfId], references: [id], onDelete: Restrict)
  manualOverrides      ContentDecision[]     @relation("ManualDecisionOverrides")
  evidenceSpans        EvidenceSpan[]
  activeFor            SelectedComment?      @relation("ActiveContentDecision")
  reviewTasks          ReviewTask[]
  previousReviewEvents ManualOverrideEvent[] @relation("PreviousReviewDecision")
  newReviewEvents      ManualOverrideEvent[] @relation("NewReviewDecision")
  createdSubjects      Subject[]             @relation("SubjectCreationDecision")
  subjectAliases       SubjectAlias[]        @relation("SubjectAliasDecision")
  subjectMentions      SubjectMention[]      @relation("SubjectMentionDecision")
  discoverySources     DiscoverySource[]     @relation("DiscoverySourceDecision")
  expertNotes          ExpertNote[]          @relation("ExpertNoteDecision")

  @@index([commentId, createdAt])
  @@index([manualOverrideOfId])
  @@map("content_decisions")
}

model ReviewTask {
  id                 String                @id @default(uuid()) @db.Uuid
  commentId          BigInt                @map("comment_id")
  contentDecisionId  String                @map("content_decision_id") @db.Uuid
  kind               ReviewTaskKind        @default(CONTENT_DECISION)
  targetKey          String                @default("content") @map("target_key")
  targetSnapshotHash String?               @map("target_snapshot_hash")
  state              ReviewTaskState       @default(OPEN)
  priority           ReviewPriority
  reasonCodes        String[]              @map("reason_codes")
  version            Int                   @default(1)
  revision           Int                   @default(1)
  supersedesTaskId   String?               @map("supersedes_task_id") @db.Uuid
  resolutionReason   String?               @map("resolution_reason")
  resolvedBy         String?               @map("resolved_by")
  resolvedAt         DateTime?             @map("resolved_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  comment            SelectedComment       @relation(fields: [commentId], references: [id], onDelete: Restrict)
  contentDecision    ContentDecision       @relation(fields: [contentDecisionId], references: [id], onDelete: Restrict)
  supersedesTask     ReviewTask?           @relation("ReviewTaskRevisions", fields: [supersedesTaskId], references: [id], onDelete: Restrict)
  supersededByTasks  ReviewTask[]          @relation("ReviewTaskRevisions")
  auditEvents        ManualOverrideEvent[]
  exportRevisions    ExportOutbox[]

  @@unique([contentDecisionId, kind, targetKey, revision])
  @@index([state, priority, createdAt, id])
  @@index([commentId, createdAt])
  @@index([supersedesTaskId])
  @@map("review_tasks")
}

model ManualOverrideEvent {
  id                     String            @id @default(uuid()) @db.Uuid
  reviewTaskId           String            @map("review_task_id") @db.Uuid
  commentId              BigInt            @map("comment_id")
  action                 ReviewAuditAction
  previousDecisionId     String?           @map("previous_decision_id") @db.Uuid
  newDecisionId          String?           @map("new_decision_id") @db.Uuid
  affectedSubjectId      String?           @map("affected_subject_id") @db.Uuid
  relatedSubjectId       String?           @map("related_subject_id") @db.Uuid
  previousUrlCandidateId String?           @map("previous_url_candidate_id") @db.Uuid
  newUrlCandidateId      String?           @map("new_url_candidate_id") @db.Uuid
  actorId                String            @map("actor_id")
  requestHash            String            @map("request_hash")
  previousValueHash      String            @map("previous_value_hash")
  newValueHash           String            @map("new_value_hash")
  reason                 String
  commandKey             String            @unique @map("command_key")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewTask             ReviewTask        @relation(fields: [reviewTaskId], references: [id], onDelete: Restrict)
  comment                SelectedComment   @relation(fields: [commentId], references: [id], onDelete: Restrict)
  previousDecision       ContentDecision?  @relation("PreviousReviewDecision", fields: [previousDecisionId], references: [id], onDelete: Restrict)
  newDecision            ContentDecision?  @relation("NewReviewDecision", fields: [newDecisionId], references: [id], onDelete: Restrict)
  affectedSubject        Subject?          @relation("AffectedSubjectReview", fields: [affectedSubjectId], references: [id], onDelete: Restrict)
  relatedSubject         Subject?          @relation("RelatedSubjectReview", fields: [relatedSubjectId], references: [id], onDelete: Restrict)
  previousUrlCandidate   UrlCandidate?     @relation("PreviousUrlCandidateReview", fields: [previousUrlCandidateId], references: [id], onDelete: Restrict)
  newUrlCandidate        UrlCandidate?     @relation("NewUrlCandidateReview", fields: [newUrlCandidateId], references: [id], onDelete: Restrict)

  @@index([reviewTaskId, createdAt])
  @@index([commentId, createdAt])
  @@index([affectedSubjectId, createdAt])
  @@index([relatedSubjectId, createdAt])
  @@map("manual_override_events")
}

model EvidenceSpan {
  id                String                    @id @default(uuid()) @db.Uuid
  contentDecisionId String                    @map("content_decision_id") @db.Uuid
  spanId            String                    @map("span_id")
  sourceDocument    String                    @map("source_document")
  origin            EvidenceOrigin
  startOffset       Int                       @map("start_offset")
  endOffset         Int                       @map("end_offset")
  textHash          String                    @map("text_hash")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  contentDecision   ContentDecision           @relation(fields: [contentDecisionId], references: [id], onDelete: Restrict)
  subjectMentions   SubjectMentionEvidence[]
  discoverySources  DiscoverySourceEvidence[]
  expertNotes       ExpertNoteEvidence[]

  @@unique([contentDecisionId, spanId])
  @@index([sourceDocument])
  @@map("evidence_spans")
}

model ResolutionPath {
  id                String          @id @default(uuid()) @db.Uuid
  selectedCommentId BigInt          @unique @map("selected_comment_id")
  ancestorIds       BigInt[]        @map("ancestor_ids")
  displayedStoryId  BigInt?         @map("displayed_story_id")
  resolvedRootId    BigInt          @map("resolved_root_id")
  resolverVersion   String          @map("resolver_version")
  resolvedAt        DateTime        @default(now()) @map("resolved_at") @db.Timestamptz(3)
  selectedComment   SelectedComment @relation(fields: [selectedCommentId], references: [id], onDelete: Cascade)

  @@index([resolvedRootId])
  @@map("resolution_paths")
}

model MultipartGroup {
  id                String          @id @default(uuid()) @db.Uuid
  selectedCommentId BigInt          @unique @map("selected_comment_id")
  expectedParts     Int             @map("expected_parts")
  state             MultipartState
  canonicalSource   String          @default("HN") @map("canonical_source")
  snapshotHash      String?         @map("snapshot_hash")
  selectedComment   SelectedComment @relation(fields: [selectedCommentId], references: [id], onDelete: Cascade)
  parts             MultipartPart[]

  @@map("multipart_groups")
}

model MultipartPart {
  id               String              @id @default(uuid()) @db.Uuid
  groupId          String              @map("group_id") @db.Uuid
  occurrenceId     String              @unique @map("occurrence_id") @db.Uuid
  partNo           Int                 @map("part_no")
  observedTotal    Int                 @map("observed_total")
  fragmentHash     String              @map("fragment_hash")
  fragmentSnapshot String?             @map("fragment_snapshot")
  group            MultipartGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  occurrence       SelectionOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([groupId, partNo])
  @@map("multipart_parts")
}

model UrlCandidate {
  id                   String                @id @default(uuid()) @db.Uuid
  hnItemId             BigInt?               @map("hn_item_id")
  rawUrl               String                @map("raw_url")
  canonicalUrl         String?               @map("canonical_url")
  sourceDocument       String                @map("source_document")
  originField          String                @map("origin_field")
  scheme               String?
  host                 String?
  validationState      UrlValidationState    @default(CANDIDATE) @map("validation_state")
  contentHash          String                @map("content_hash")
  sourceOrdinal        Int                   @default(0) @map("source_ordinal")
  classifierEligible   Boolean               @default(true) @map("classifier_eligible")
  hnItem               HnItem?               @relation(fields: [hnItemId], references: [id], onDelete: Cascade)
  canonicalFor         Subject[]
  previousReviewEvents ManualOverrideEvent[] @relation("PreviousUrlCandidateReview")
  newReviewEvents      ManualOverrideEvent[] @relation("NewUrlCandidateReview")

  @@unique([contentHash, sourceDocument, originField, sourceOrdinal])
  @@index([hnItemId])
  @@index([classifierEligible, sourceDocument, sourceOrdinal])
  @@map("url_candidates")
}

model Subject {
  id                      String                @id @default(uuid()) @db.Uuid
  type                    SubjectType
  name                    String
  normalizedName          String                @map("normalized_name")
  dedupKey                String                @unique @map("dedup_key")
  identityBasis           SubjectIdentityBasis  @map("identity_basis")
  ecosystemCoordinate     String?               @map("ecosystem_coordinate")
  canonicalUrlCandidateId String?               @map("canonical_url_candidate_id") @db.Uuid
  officialDomain          String?               @map("official_domain")
  contextKey              String                @map("context_key")
  lifecycleState          SubjectLifecycleState @default(ACTIVE) @map("lifecycle_state")
  mergedIntoSubjectId     String?               @map("merged_into_subject_id") @db.Uuid
  createdFromDecisionId   String                @map("created_from_decision_id") @db.Uuid
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  canonicalUrlCandidate   UrlCandidate?         @relation(fields: [canonicalUrlCandidateId], references: [id], onDelete: Restrict)
  createdFromDecision     ContentDecision       @relation("SubjectCreationDecision", fields: [createdFromDecisionId], references: [id], onDelete: Restrict)
  mergedIntoSubject       Subject?              @relation("SubjectMerges", fields: [mergedIntoSubjectId], references: [id], onDelete: Restrict)
  mergedSubjects          Subject[]             @relation("SubjectMerges")
  aliases                 SubjectAlias[]
  mentions                SubjectMention[]
  discoveries             Discovery[]
  expertNotes             ExpertNoteSubject[]
  affectedReviewEvents    ManualOverrideEvent[] @relation("AffectedSubjectReview")
  relatedReviewEvents     ManualOverrideEvent[] @relation("RelatedSubjectReview")

  @@index([normalizedName, type])
  @@index([ecosystemCoordinate])
  @@index([officialDomain])
  @@index([canonicalUrlCandidateId])
  @@index([mergedIntoSubjectId])
  @@index([createdFromDecisionId])
  @@map("subjects")
}

model SubjectAlias {
  id                String          @id @default(uuid()) @db.Uuid
  subjectId         String          @map("subject_id") @db.Uuid
  alias             String
  normalizedAlias   String          @map("normalized_alias")
  contentDecisionId String          @map("content_decision_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  contentDecision   ContentDecision @relation("SubjectAliasDecision", fields: [contentDecisionId], references: [id], onDelete: Restrict)

  @@unique([subjectId, normalizedAlias])
  @@index([contentDecisionId])
  @@map("subject_aliases")
}

model SubjectMention {
  id                String                     @id @default(uuid()) @db.Uuid
  subjectId         String                     @map("subject_id") @db.Uuid
  selectedCommentId BigInt                     @map("selected_comment_id")
  contentDecisionId String                     @map("content_decision_id") @db.Uuid
  sourceKind        SubjectMentionSource       @map("source_kind")
  sourceOrdinal     Int                        @map("source_ordinal")
  evidenceOrigin    MaterializedEvidenceOrigin @map("evidence_origin")
  confidence        Float
  extractionVersion String                     @map("extraction_version")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  subject           Subject                    @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  selectedComment   SelectedComment            @relation(fields: [selectedCommentId], references: [id], onDelete: Restrict)
  contentDecision   ContentDecision            @relation("SubjectMentionDecision", fields: [contentDecisionId], references: [id], onDelete: Restrict)
  evidenceSpans     SubjectMentionEvidence[]

  @@unique([contentDecisionId, sourceKind, sourceOrdinal, subjectId])
  @@index([subjectId, createdAt])
  @@index([selectedCommentId])
  @@map("subject_mentions")
}

model SubjectMentionEvidence {
  subjectMentionId String         @map("subject_mention_id") @db.Uuid
  evidenceSpanId   String         @map("evidence_span_id") @db.Uuid
  subjectMention   SubjectMention @relation(fields: [subjectMentionId], references: [id], onDelete: Restrict)
  evidenceSpan     EvidenceSpan   @relation(fields: [evidenceSpanId], references: [id], onDelete: Restrict)

  @@id([subjectMentionId, evidenceSpanId])
  @@index([evidenceSpanId])
  @@map("subject_mention_evidence_spans")
}

model Discovery {
  id                  String                    @id @default(uuid()) @db.Uuid
  subjectId           String                    @map("subject_id") @db.Uuid
  resolvedRootId      BigInt?                   @map("resolved_root_id")
  identityKey         String                    @unique @map("identity_key")
  rootStoryOnly       Boolean                   @map("root_story_only")
  extractionVersion   String                    @map("extraction_version")
  status              MaterializedContentStatus @default(REVIEW_PENDING)
  publicationRevision Int                       @default(1) @map("publication_revision")
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  subject             Subject                   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  resolvedRoot        HnItem?                   @relation("DiscoveryResolvedRoot", fields: [resolvedRootId], references: [id], onDelete: Restrict)
  sources             DiscoverySource[]
  exportRevisions     ExportOutbox[]

  @@index([subjectId, status])
  @@index([resolvedRootId])
  @@map("discoveries")
}

model ExportOutbox {
  id              String                 @id @default(uuid()) @db.Uuid
  exportId        String                 @map("export_id") @db.Uuid
  destination     ExportDestination
  discoveryId     String                 @map("discovery_id") @db.Uuid
  revision        Int
  action          ExportAction
  payload         Json
  payloadHash     String                 @map("payload_hash")
  sourceHash      String                 @map("source_hash")
  deliveryState   ExportDeliveryState    @default(PENDING) @map("delivery_state")
  reviewTaskId    String?                @unique @map("review_task_id") @db.Uuid
  acknowledgedAt  DateTime?              @map("acknowledged_at") @db.Timestamptz(3)
  lastErrorCode   String?                @map("last_error_code")
  lastErrorAt     DateTime?              @map("last_error_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  discovery       Discovery              @relation(fields: [discoveryId], references: [id], onDelete: Restrict)
  reviewTask      ReviewTask?            @relation(fields: [reviewTaskId], references: [id], onDelete: Restrict)
  acknowledgement ExportAcknowledgement?

  @@unique([exportId, revision])
  @@unique([destination, discoveryId, revision])
  @@index([destination, deliveryState, createdAt, id])
  @@index([discoveryId, createdAt])
  @@map("export_outbox")
}

model ExportAcknowledgement {
  id             String            @id @default(uuid()) @db.Uuid
  outboxId       String            @unique @map("outbox_id") @db.Uuid
  destination    ExportDestination
  exportId       String            @map("export_id") @db.Uuid
  revision       Int
  consumerId     String            @map("consumer_id")
  idempotencyKey String            @map("idempotency_key")
  payloadHash    String            @map("payload_hash")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  outbox         ExportOutbox      @relation(fields: [outboxId], references: [id], onDelete: Restrict)

  @@unique([destination, idempotencyKey])
  @@unique([exportId, revision])
  @@index([consumerId, createdAt])
  @@map("export_acknowledgements")
}

model DiscoverySource {
  id                String                     @id @default(uuid()) @db.Uuid
  discoveryId       String                     @map("discovery_id") @db.Uuid
  selectedCommentId BigInt                     @map("selected_comment_id")
  contentDecisionId String                     @map("content_decision_id") @db.Uuid
  sourceOrdinal     Int                        @map("source_ordinal")
  descriptionClaim  String                     @map("description_claim")
  evidenceOrigin    MaterializedEvidenceOrigin @map("evidence_origin")
  confidence        Float
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  discovery         Discovery                  @relation(fields: [discoveryId], references: [id], onDelete: Restrict)
  selectedComment   SelectedComment            @relation(fields: [selectedCommentId], references: [id], onDelete: Restrict)
  contentDecision   ContentDecision            @relation("DiscoverySourceDecision", fields: [contentDecisionId], references: [id], onDelete: Restrict)
  evidenceSpans     DiscoverySourceEvidence[]

  @@unique([contentDecisionId, sourceOrdinal])
  @@index([discoveryId, createdAt])
  @@index([selectedCommentId])
  @@map("discovery_sources")
}

model DiscoverySourceEvidence {
  discoverySourceId String          @map("discovery_source_id") @db.Uuid
  evidenceSpanId    String          @map("evidence_span_id") @db.Uuid
  discoverySource   DiscoverySource @relation(fields: [discoverySourceId], references: [id], onDelete: Restrict)
  evidenceSpan      EvidenceSpan    @relation(fields: [evidenceSpanId], references: [id], onDelete: Restrict)

  @@id([discoverySourceId, evidenceSpanId])
  @@index([evidenceSpanId])
  @@map("discovery_source_evidence_spans")
}

model ExpertNote {
  id                  String                     @id @default(uuid()) @db.Uuid
  selectedCommentId   BigInt                     @map("selected_comment_id")
  contentDecisionId   String                     @map("content_decision_id") @db.Uuid
  noteType            ExpertNoteType             @map("note_type")
  title               String
  summary             String
  relatedSubjectNames String[]                   @map("related_subject_names")
  evidenceOrigin      MaterializedEvidenceOrigin @map("evidence_origin")
  confidence          Float
  status              MaterializedContentStatus  @default(REVIEW_PENDING)
  publicationRevision Int                        @default(1) @map("publication_revision")
  extractionVersion   String                     @map("extraction_version")
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  selectedComment     SelectedComment            @relation(fields: [selectedCommentId], references: [id], onDelete: Restrict)
  contentDecision     ContentDecision            @relation("ExpertNoteDecision", fields: [contentDecisionId], references: [id], onDelete: Restrict)
  subjects            ExpertNoteSubject[]
  evidenceSpans       ExpertNoteEvidence[]

  @@unique([contentDecisionId, extractionVersion])
  @@index([selectedCommentId, status])
  @@map("expert_notes")
}

model ExpertNoteSubject {
  expertNoteId String     @map("expert_note_id") @db.Uuid
  subjectId    String     @map("subject_id") @db.Uuid
  expertNote   ExpertNote @relation(fields: [expertNoteId], references: [id], onDelete: Restrict)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([expertNoteId, subjectId])
  @@index([subjectId])
  @@map("expert_note_subjects")
}

model ExpertNoteEvidence {
  expertNoteId   String       @map("expert_note_id") @db.Uuid
  evidenceSpanId String       @map("evidence_span_id") @db.Uuid
  expertNote     ExpertNote   @relation(fields: [expertNoteId], references: [id], onDelete: Restrict)
  evidenceSpan   EvidenceSpan @relation(fields: [evidenceSpanId], references: [id], onDelete: Restrict)

  @@id([expertNoteId, evidenceSpanId])
  @@index([evidenceSpanId])
  @@map("expert_note_evidence_spans")
}

model HnItemRevision {
  id           String              @id @default(uuid()) @db.Uuid
  hnItemId     BigInt              @map("hn_item_id")
  type         HnItemType
  parentId     BigInt?             @map("parent_id")
  title        String?
  textHtml     String?             @map("text_html")
  textPlain    String?             @map("text_plain")
  url          String?
  availability HnAvailabilityState
  responseHash String              @map("response_hash")
  observedAt   DateTime            @map("observed_at") @db.Timestamptz(3)
  item         HnItem              @relation(fields: [hnItemId], references: [id], onDelete: Restrict)

  @@unique([hnItemId, responseHash])
  @@index([hnItemId, observedAt])
  @@map("hn_item_revisions")
}

model SelectedCommentRevision {
  id                String              @id @default(uuid()) @db.Uuid
  selectedCommentId BigInt              @map("selected_comment_id")
  revision          Int
  rootId            BigInt              @map("root_id")
