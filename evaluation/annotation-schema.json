{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hn-knowledge.local/schemas/gold-annotation-v1.json",
  "title": "Gold annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commentId",
    "primaryClass",
    "evidenceSpans",
    "discoveries",
    "expertNote",
    "reviewFlags",
    "rejectionReason",
    "holdout",
    "annotation"
  ],
  "properties": {
    "schemaVersion": { "const": "gold.v1" },
    "commentId": { "type": "integer", "minimum": 1 },
    "primaryClass": {
      "enum": ["DISCOVERY", "EXPERT_NOTE", "REJECTED"]
    },
    "evidenceSpans": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/evidenceSpan" }
    },
    "discoveries": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/discovery" }
    },
    "expertNote": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/expertNote" }]
    },
    "reviewFlags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/reviewFlag" }
    },
    "rejectionReason": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rejectionReason" }]
    },
    "holdout": { "type": "boolean" },
    "annotation": { "$ref": "#/$defs/annotationMetadata" }
  },
  "$defs": {
    "evidenceOrigin": {
      "enum": ["COMMENT", "ROOT_STORY", "BOTH"]
    },
    "evidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "documentId",
        "origin",
        "start",
        "end",
        "text",
        "textSha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^span:[a-z]+:[0-9]+$" },
        "documentId": {
          "type": "string",
          "pattern": "^(comment|root):[1-9][0-9]*$"
        },
        "origin": { "enum": ["COMMENT", "ROOT_STORY"] },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "textSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "subjectType": {
      "enum": [
        "PROJECT",
        "TOOL",
        "LIBRARY",
        "SERVICE",
        "PRODUCT",
        "FEATURE",
        "PLUGIN",
        "AGENT_SKILL",
        "GUIDE",
        "RESOURCE"
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectType",
        "name",
        "aliases",
        "description",
        "evidenceOrigin",
        "evidenceSpanIds",
        "urlCandidateIds",
        "rootOnly"
      ],
      "properties": {
        "subjectType": { "$ref": "#/$defs/subjectType" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceOrigin": { "$ref": "#/$defs/evidenceOrigin" },
        "evidenceSpanIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 12,
          "items": { "type": "string", "pattern": "^span:[a-z]+:[0-9]+$" }
        },
        "urlCandidateIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": { "type": "string", "pattern": "^url:[0-9]+$" }
        },
        "rootOnly": { "type": "boolean" }
      }
    },
    "noteType": {
      "enum": [
        "TECHNICAL_EXPLANATION",
        "CORRECTION",
        "PRODUCT_EXPERIENCE",
        "IMPLEMENTATION_CAVEAT",
        "SECURITY",
        "OPERATIONS",
        "COMPARISON",
        "GUIDE"
      ]
    },
    "expertNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noteType",
        "title",
        "summary",
        "evidenceOrigin",
        "evidenceSpanIds",
        "relatedSubjectNames",
        "qualifiers"
      ],
      "properties": {
        "noteType": { "$ref": "#/$defs/noteType" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidenceOrigin": { "$ref": "#/$defs/evidenceOrigin" },
        "evidenceSpanIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 16,
          "items": { "type": "string", "pattern": "^span:[a-z]+:[0-9]+$" }
        },
        "relatedSubjectNames": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "qualifiers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "reviewFlag": {
      "enum": [
        "MISSING_CANONICAL_URL",
        "AMBIGUOUS_CANONICAL_URL",
        "ROOT_ONLY_DISCOVERY",
        "LEGAL_RECOMMENDATION",
        "MEDICAL_RECOMMENDATION",
        "SECURITY_RECOMMENDATION",
        "DESTRUCTIVE_OR_EVASION_ADVICE",
        "LOW_CONFIDENCE",
        "PROMPT_INJECTION",
        "UNAVAILABLE_CONTENT",
        "TELEGRAM_HN_DIVERGENCE",
        "CONFLICTING_EVIDENCE_ORIGIN",
        "INVALID_EVIDENCE_SPAN",
        "UNSUPPORTED_URL",
        "AMBIGUOUS_CLASSIFICATION"
      ]
    },
    "rejectionReason": {
      "enum": [
        "NON_TECHNICAL",
        "JOKE_OR_ONE_LINER",
        "GENERIC_OPINION",
        "PERSONAL_STORY",
        "INCIDENTAL_MENTION",
        "NEWS_WITHOUT_REUSABLE_DETAIL",
        "UNAVAILABLE_CONTENT",
        "LOW_INFORMATION"
      ]
    },
    "annotationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotatorA", "annotatorB", "adjudication"],
      "properties": {
        "annotatorA": { "$ref": "#/$defs/annotatorDecision" },
        "annotatorB": { "$ref": "#/$defs/annotatorDecision" },
        "adjudication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adjudicator", "disagreement", "rationale"],
          "properties": {
            "adjudicator": { "const": "codex-root" },
            "disagreement": { "type": "boolean" },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "annotatorDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primaryClass"],
      "properties": {
        "id": { "enum": ["A", "B"] },
        "primaryClass": {
          "enum": ["DISCOVERY", "EXPERT_NOTE", "REJECTED"]
        }
      }
    }
  }
}
