{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hn-knowledge.local/schemas/annotation-pass-v2.json",
  "title": "Independent evaluation annotation pass v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cycleId",
    "commentId",
    "materialRelevance",
    "primaryClass",
    "discoveries",
    "expertNote",
    "reviewFlags",
    "rejectionReason",
    "annotator"
  ],
  "properties": {
    "schemaVersion": { "const": "annotation-pass.v2" },
    "cycleId": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "commentId": { "type": "integer", "minimum": 1 },
    "materialRelevance": {
      "enum": ["MATERIAL", "NOT_MATERIAL", "UNCERTAIN"]
    },
    "primaryClass": {
      "enum": ["DISCOVERY", "EXPERT_NOTE", "REJECTED"]
    },
    "discoveries": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/discovery" }
    },
    "expertNote": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/expertNote" }]
    },
    "reviewFlags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/reviewFlag" }
    },
    "rejectionReason": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/rejectionReason" }]
    },
    "annotator": { "$ref": "#/$defs/annotator" }
  },
  "allOf": [
    {
      "if": { "properties": { "primaryClass": { "const": "DISCOVERY" } } },
      "then": {
        "properties": {
          "discoveries": { "minItems": 1 },
          "rejectionReason": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "primaryClass": { "const": "EXPERT_NOTE" } } },
      "then": {
        "properties": {
          "discoveries": { "maxItems": 0 },
          "expertNote": { "$ref": "#/$defs/expertNote" },
          "rejectionReason": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "primaryClass": { "const": "REJECTED" } } },
      "then": {
        "properties": {
          "discoveries": { "maxItems": 0 },
          "expertNote": { "type": "null" },
          "rejectionReason": { "$ref": "#/$defs/rejectionReason" }
        }
      }
    },
    {
      "if": {
        "properties": { "materialRelevance": { "const": "MATERIAL" } }
      },
      "then": {
        "properties": { "primaryClass": { "not": { "const": "REJECTED" } } }
      }
    },
    {
      "if": {
        "properties": { "materialRelevance": { "const": "NOT_MATERIAL" } }
      },
      "then": { "properties": { "primaryClass": { "const": "REJECTED" } } }
    },
    {
      "if": {
        "properties": { "materialRelevance": { "const": "UNCERTAIN" } }
      },
      "then": {
        "properties": {
          "reviewFlags": { "contains": { "const": "AMBIGUOUS_CLASSIFICATION" } }
        }
      }
    }
  ],
  "$defs": {
    "derivedText": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "https?://" }
    },
    "evidenceOrigin": {
      "enum": ["COMMENT", "ROOT_STORY", "BOTH"]
    },
    "evidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "start", "end", "text"],
      "properties": {
        "origin": { "enum": ["COMMENT", "ROOT_STORY"] },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "subjectType": {
      "enum": [
        "PROJECT",
        "TOOL",
        "LIBRARY",
        "SERVICE",
        "PRODUCT",
        "FEATURE",
        "PLUGIN",
        "AGENT_SKILL",
        "GUIDE",
        "RESOURCE"
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectType",
        "name",
        "aliases",
        "description",
        "evidenceOrigin",
        "evidenceSpans",
        "urlCandidateIds",
        "rootOnly"
      ],
      "properties": {
        "subjectType": { "$ref": "#/$defs/subjectType" },
        "name": {
          "allOf": [{ "$ref": "#/$defs/derivedText" }, { "maxLength": 160 }]
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "allOf": [{ "$ref": "#/$defs/derivedText" }, { "maxLength": 160 }]
          }
        },
        "description": {
          "allOf": [{ "$ref": "#/$defs/derivedText" }, { "maxLength": 1000 }]
        },
        "evidenceOrigin": { "$ref": "#/$defs/evidenceOrigin" },
        "evidenceSpans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/evidenceSpan" }
        },
        "urlCandidateIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": { "type": "string", "pattern": "^url:[0-9]+$" }
        },
        "rootOnly": { "type": "boolean" }
      }
    },
    "noteType": {
      "enum": [
        "TECHNICAL_EXPLANATION",
        "CORRECTION",
        "PRODUCT_EXPERIENCE",
        "IMPLEMENTATION_CAVEAT",
        "SECURITY",
        "OPERATIONS",
        "COMPARISON",
        "GUIDE"
      ]
    },
    "expertNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noteType",
        "title",
        "summary",
        "evidenceOrigin",
        "evidenceSpans",
        "relatedSubjectNames",
        "qualifiers"
      ],
      "properties": {
        "noteType": { "$ref": "#/$defs/noteType" },
        "title": {
          "allOf": [{ "$ref": "#/$defs/derivedText" }, { "maxLength": 200 }]
        },
        "summary": {
          "allOf": [{ "$ref": "#/$defs/derivedText" }, { "maxLength": 2000 }]
        },
        "evidenceOrigin": { "$ref": "#/$defs/evidenceOrigin" },
        "evidenceSpans": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/evidenceSpan" }
        },
        "relatedSubjectNames": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "allOf": [{ "$ref": "#/$defs/derivedText" }, { "maxLength": 160 }]
          }
        },
        "qualifiers": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "allOf": [{ "$ref": "#/$defs/derivedText" }, { "maxLength": 300 }]
          }
        }
      }
    },
    "reviewFlag": {
      "enum": [
        "MISSING_CANONICAL_URL",
        "AMBIGUOUS_CANONICAL_URL",
        "ROOT_ONLY_DISCOVERY",
        "LEGAL_RECOMMENDATION",
        "MEDICAL_RECOMMENDATION",
        "SECURITY_RECOMMENDATION",
        "DESTRUCTIVE_OR_EVASION_ADVICE",
        "LOW_CONFIDENCE",
        "PROMPT_INJECTION",
        "UNAVAILABLE_CONTENT",
        "TELEGRAM_HN_DIVERGENCE",
        "CONFLICTING_EVIDENCE_ORIGIN",
        "INVALID_EVIDENCE_SPAN",
        "UNSUPPORTED_URL",
        "AMBIGUOUS_CLASSIFICATION"
      ]
    },
    "rejectionReason": {
      "enum": [
        "NON_TECHNICAL",
        "JOKE_OR_ONE_LINER",
        "GENERIC_OPINION",
        "PERSONAL_STORY",
        "INCIDENTAL_MENTION",
        "NEWS_WITHOUT_REUSABLE_DETAIL",
        "UNAVAILABLE_CONTENT",
        "LOW_INFORMATION"
      ]
    },
    "annotator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method"],
      "properties": {
        "id": { "enum": ["A", "B"] },
        "method": { "const": "independent-bounded-review" }
      }
    }
  }
}
